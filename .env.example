MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/drex
PORT=4000
SERVE_FRONTEND=false
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-secret
# Optional fallback only; SMTP is the preferred transactional email transport
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Drex <hello@yourdomain.com>
APP_URL=http://localhost:5173
UPLOAD_DIR=uploads
FLUTTERWAVE_MODE=test
FLW_PUBLIC_KEY=FLWPUBK_TEST-your-key
FLW_SECRET_KEY=FLWSECK_TEST-your-key
FLW_WEBHOOK_HASH=your-webhook-secret-hash
PAYMENT_CURRENCY=USD
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/youtube/oauth/callback
TOKEN_ENCRYPTION_KEY=32-byte-base64-or-hex-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
REDIS_URL=redis://localhost:6379
IMAGE_QUEUE_ENABLED=false
STUDIO_QUEUE_ENABLED=false
RENDER_QUEUE_ENABLED=false
# Optional absolute paths; bundled ffmpeg-static / ffprobe-static are used by default.
FFMPEG_PATH=
FFPROBE_PATH=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
VEO_MODEL=veo-3.1-generate-preview

# Phase 13: provision once using private Render environment settings. Never commit real credentials.
ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD_HASH=<Argon2id hash from admin:credentials>
# ADMIN_TOTP_SECRET=<private Base32 authenticator secret>

# Creator additions: private backend/worker settings only
ADMIN_LOGIN_METHOD=email
# Optional one-time bootstrap alternative to the password hash. Remove after provisioning.
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-private-password-at-least-14-characters
# HEYGEN_API_KEY=
# AVATAR_PRESENTERS_JSON=[]

# Primary AI gateway (server and AI workers only). Keep direct keys until live migration tests pass.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-3.8-flash

# Server-only account balance/activity reporting key
OPENROUTER_MANAGEMENT_KEY=
